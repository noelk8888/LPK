# Google Sheets API - Service Account Credentials
# Get these from your Google Cloud Console service account JSON key
GOOGLE_SERVICE_ACCOUNT_EMAIL=your-service-account@your-project.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_KEY_HERE\n-----END PRIVATE KEY-----\n"

# Google Spreadsheet ID (from the sheet URL)
GOOGLE_SPREADSHEET_ID=your-spreadsheet-id

# Dashboard Password (simple auth)
DASHBOARD_PASSWORD=your-secret-password

# Sheet tab names (comma-separated)
SHEET_TABS=2023,2024,2025,2026
